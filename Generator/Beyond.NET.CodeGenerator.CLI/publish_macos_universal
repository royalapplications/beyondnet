#!/usr/bin/env bash

set -e

# NativeAOT links against OpenSSL and Brotli on macOS; Homebrew installs are not on the default linker path.
configure_native_aot_linker_paths() {
  local paths=()

  if command -v brew >/dev/null 2>&1; then
    for pkg in openssl@3 brotli; do
      local prefix
      prefix="$(brew --prefix "${pkg}" 2>/dev/null)" || continue

      if [ -d "${prefix}/lib" ]; then
        paths+=("${prefix}/lib")
      fi
    done
  fi

  for dir in \
    /opt/homebrew/opt/openssl@3/lib \
    /usr/local/opt/openssl@3/lib \
    /opt/homebrew/opt/brotli/lib \
    /usr/local/opt/brotli/lib; do
    if [ -d "${dir}" ]; then
      paths+=("${dir}")
    fi
  done

  if [ ${#paths[@]} -eq 0 ]; then
    echo "Warning: OpenSSL/Brotli library paths not found. NativeAOT publish may fail with \"library 'ssl' not found\"."
    echo "Install dependencies with: brew install openssl@3 brotli"
    return
  fi

  local joined=""
  local dir

  for dir in "${paths[@]}"; do
    case ":${joined}:" in
      *":${dir}:"*) ;;
      *)
        if [ -n "${joined}" ]; then
          joined="${joined}:${dir}"
        else
          joined="${dir}"
        fi
        ;;
    esac
  done

  export LIBRARY_PATH="${joined}${LIBRARY_PATH:+:${LIBRARY_PATH}}"
  echo "NativeAOT linker library paths: ${joined}"
}

configure_native_aot_linker_paths

OUTPUT_PRODUCT_NAME="beyondnetgen"
BUILD_CONFIGURATION="Release"

OUTPUT_FILE_NAME="${OUTPUT_PRODUCT_NAME}"

VERBOSITY_LEVEL="normal"

RUNTIME_IDENTIFIER_X64="osx-x64"
RUNTIME_IDENTIFIER_ARM64="osx-arm64"
RUNTIME_IDENTIFIER_UNIVERSAL="osx-universal"

BIN_DIR="bin"
PUBLISH_DIR="publish"

X64_BUILD_DIR="${BIN_DIR}/${BUILD_CONFIGURATION}/${RUNTIME_IDENTIFIER_X64}/${PUBLISH_DIR}"
ARM64_BUILD_DIR="${BIN_DIR}/${BUILD_CONFIGURATION}/${RUNTIME_IDENTIFIER_ARM64}/${PUBLISH_DIR}"
UNIVERSAL_BUILD_DIR="${BIN_DIR}/${BUILD_CONFIGURATION}/${RUNTIME_IDENTIFIER_UNIVERSAL}/${PUBLISH_DIR}"

X64_FILE_PATH="${X64_BUILD_DIR}/${OUTPUT_FILE_NAME}"
ARM64_FILE_PATH="${ARM64_BUILD_DIR}/${OUTPUT_FILE_NAME}"
UNIVERSAL_FILE_PATH="${UNIVERSAL_BUILD_DIR}/${OUTPUT_FILE_NAME}"

echo "Building ${OUTPUT_PRODUCT_NAME} for x64"
dotnet publish -r ${RUNTIME_IDENTIFIER_X64} -v "${VERBOSITY_LEVEL}"

echo "Building ${OUTPUT_PRODUCT_NAME} for ARM64"
dotnet publish -r ${RUNTIME_IDENTIFIER_ARM64} -v "${VERBOSITY_LEVEL}"

echo "Making directory for universal ${OUTPUT_PRODUCT_NAME} build"
mkdir -p "${UNIVERSAL_BUILD_DIR}"

echo "Making ${OUTPUT_PRODUCT_NAME} universal build"
lipo -create "${X64_FILE_PATH}" "${ARM64_FILE_PATH}" -output "${UNIVERSAL_FILE_PATH}"